# C1 application image. Release publication requires the active milestone gate.
# Pins are amd64 platform digests; see images.json for index digests and licenses.
FROM ghcr.io/astral-sh/uv@sha256:596e7ea716217d76ff7ddfb8695833f7cb2a8d6589af32114a1b4a95c081fd4d AS uv

FROM docker.io/library/python@sha256:b92e6b9bb1ea9d826e9956fd8d30bf18bc384c130231d74fdf0ba3460c290b0b AS build
COPY --from=uv /uv /usr/local/bin/uv
ENV UV_PYTHON_DOWNLOADS=never \
    UV_LINK_MODE=copy \
    UV_COMPILE_BYTECODE=1 \
    UV_PROJECT_ENVIRONMENT=/opt/c1
WORKDIR /src
COPY pyproject.toml uv.lock README.md LICENSE NOTICE THIRD_PARTY_NOTICES ./
COPY src src
COPY profiles profiles
COPY deployment/openfga/c1-v1.json deployment/openfga/c1-v1.json
# Runtime dependencies only, exactly as locked; the project is installed as a wheel.
RUN uv sync --locked --no-dev --no-editable --python /usr/local/bin/python3.13 \
 && install -D -m 0644 LICENSE /opt/c1/share/c1/LICENSE \
 && install -D -m 0644 NOTICE /opt/c1/share/c1/NOTICE \
 && install -D -m 0644 THIRD_PARTY_NOTICES /opt/c1/share/c1/THIRD_PARTY_NOTICES

FROM docker.io/library/python@sha256:b92e6b9bb1ea9d826e9956fd8d30bf18bc384c130231d74fdf0ba3460c290b0b
RUN groupadd --system --gid 10001 c1 \
 && useradd --system --uid 10001 --gid 10001 --no-create-home --shell /usr/sbin/nologin c1
COPY --from=build /opt/c1 /opt/c1
COPY deployment/reference/c1-entrypoint.sh /usr/local/bin/c1-entrypoint
ENV PATH=/opt/c1/bin:/usr/local/bin:/usr/bin:/bin \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    FORWARDED_ALLOW_IPS=127.0.0.1
ARG C1_VERSION=0.1.0rc2
ARG C1_REVISION=unknown
LABEL org.opencontainers.image.title="C1" \
      org.opencontainers.image.version=$C1_VERSION \
      org.opencontainers.image.revision=$C1_REVISION \
      org.opencontainers.image.licenses="Apache-2.0" \
      org.opencontainers.image.source="https://github.com/Stell0/c1"
EXPOSE 8000
ENTRYPOINT ["/usr/local/bin/c1-entrypoint"]
CMD ["uvicorn", "c1.web:from_env", "--factory", "--host", "0.0.0.0", "--port", "8000", "--proxy-headers", "--no-access-log"]

# Rendered by `c1-admin bootstrap` into state/nginx.conf (@PREFIX@ = backend /24).
worker_processes 1;
pid /tmp/nginx.pid;
error_log /dev/stderr warn;
events { worker_connections 256; }
http {
  server_tokens off;
  access_log off;
  client_max_body_size 1100k;
  client_body_temp_path /tmp/client_body;
  proxy_temp_path /tmp/proxy;
  fastcgi_temp_path /tmp/fastcgi;
  uwsgi_temp_path /tmp/uwsgi;
  scgi_temp_path /tmp/scgi;
  ssl_protocols TLSv1.2 TLSv1.3;
  ssl_certificate /etc/c1-certs/server.pem;
  ssl_certificate_key /etc/c1-certs/server.key;
  proxy_http_version 1.1;
  proxy_read_timeout 300s;
  proxy_set_header Host $host:$server_port;
  proxy_set_header X-Forwarded-For $remote_addr;
  proxy_set_header X-Forwarded-Proto https;
  proxy_set_header X-Forwarded-Host $host:$server_port;
  proxy_set_header X-Forwarded-Port $server_port;

  # C1 API and Explorer.
  server {
    listen 18443 ssl;
    server_name c1.test;
    location /v1/ { proxy_pass http://@PREFIX@.20:8000; }
    location /explorer { proxy_pass http://@PREFIX@.20:8000; }
    location / { return 404; }
  }

  # Keycloak: realm endpoints and login resources only; no admin console.
  server {
    listen 18443 ssl;
    server_name auth.c1.test;
    proxy_buffer_size 16k;
    proxy_buffers 8 16k;
    location /realms/ { proxy_pass http://@PREFIX@.13:8080; }
    location /resources/ { proxy_pass http://@PREFIX@.13:8080; }
    location / { return 404; }
  }

  server {
    listen 18443 ssl default_server;
    return 444;
  }
}

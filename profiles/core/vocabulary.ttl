# C1 core 1.0.0 — declarative RDFS vocabulary; no entailment is run on instance data.
@prefix c1: <urn:c1:ns:core#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

c1:ApplyReceipt a rdfs:Class .
c1:Assertion a rdfs:Class ; rdfs:subClassOf rdf:Statement .
c1:ChangeSet a rdfs:Class .
c1:Document a rdfs:Class .
c1:DocumentPart a rdfs:Class .
c1:Entity a rdfs:Class .
c1:Evidence a rdfs:Class .
c1:Keyword a rdfs:Class .
c1:ResolutionRecord a rdfs:Class .
c1:ReviewDecision a rdfs:Class .
c1:SchemaProfile a rdfs:Class .
c1:Selector a rdfs:Class .
c1:Source a rdfs:Class .
c1:TimeBoundary a rdfs:Class .
c1:TimeInterval a rdfs:Class .
c1:ValidationReport a rdfs:Class .

c1:applyReceipt a rdf:Property .
c1:assertionRef a rdf:Property .
c1:baseRevision a rdf:Property .
c1:boundaryState a rdf:Property .
c1:candidate a rdf:Property .
c1:changeSet a rdf:Property .
c1:confidence a rdf:Property .
c1:confidenceMethod a rdf:Property .
c1:contentDigest a rdf:Property .
c1:decision a rdf:Property .
c1:diagnostic a rdf:Property .
c1:evidence a rdf:Property .
c1:excerpt a rdf:Property .
c1:intendedCreationScope a rdf:Property .
c1:keyword a rdf:Property .
c1:keywordLanguage a rdf:Property .
c1:keywordText a rdf:Property .
c1:knowledgeCommit a rdf:Property .
c1:lifecycle a rdf:Property .
c1:manualStatement a rdf:Property .
c1:method a rdf:Property .
c1:normalizationVersion a rdf:Property .
c1:normalizedKeyword a rdf:Property .
c1:observedAt a rdf:Property .
c1:orderKey a rdf:Property .
c1:origin a rdf:Property .
c1:outcome a rdf:Property .
c1:output a rdf:Property .
c1:partKind a rdf:Property .
c1:partOfDocument a rdf:Property .
c1:profileName a rdf:Property .
c1:profileVersion a rdf:Property .
c1:projectReference a rdf:Property .
c1:proposedEvidence a rdf:Property .
c1:proposedOperation a rdf:Property .
c1:provisionedScopeHint a rdf:Property .
c1:rationale a rdf:Property .
c1:requestDigest a rdf:Property .
c1:resultRevision a rdf:Property .
c1:revenue a rdf:Property .
c1:reviewDecision a rdf:Property .
c1:reviewState a rdf:Property .
c1:selectorKind a rdf:Property .
c1:sourceKind a rdf:Property .
c1:sourceRevision a rdf:Property .
c1:status a rdf:Property .
c1:targetResource a rdf:Property .
c1:text a rdf:Property .
c1:toolName a rdf:Property .
c1:toolVersion a rdf:Property .
c1:validDuring a rdf:Property .
c1:validationReport a rdf:Property .
c1:worksFor a rdf:Property .

                    second = await db.replace_records(
                        ValidatedBatch(records=[changed]), registry, expected_head=first
                    )
                    assert second != first
                    assert await db.get_record(original.id, registry) == changed
                    assert await db.get_record(original.id, registry, commit=first) == original
                finally:
                    await db.drop()


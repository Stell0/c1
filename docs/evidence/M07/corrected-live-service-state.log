command: PYTHONPATH=. UV_OFFLINE=1 UV_CACHE_DIR=.uv-cache uv run --locked python - <<'PY' [read-only script: probes.config.runtime(); for each of terminusdb, postgres, openfga, keycloak run `podman ps -a --filter label=com.docker.compose.project=c1-dev --filter label=com.docker.compose.service=<service> --format '{{.ID}}'`; for the single ID run `podman inspect --format '{{.State.Status}}\t{{.State.OOMKilled}}\t{{.State.ExitCode}}\t{{.State.StartedAt}}\t{{.State.FinishedAt}}' <id>`; record only selected fields] 
exit=0
